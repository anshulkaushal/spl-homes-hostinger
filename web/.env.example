# local | staging | production
APP_ENV=local
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NOINDEX=true

# Set true only when DATABASE_URL is a real MySQL server.
USE_MYSQL=false

# Hostinger MySQL. For Node.js use the Remote MySQL hostname, not localhost.
# mysql://USER:PASSWORD@MYSQL_HOSTNAME:3306/DATABASE
DATABASE_URL="mysql://user:password@127.0.0.1:3306/spl_homes_local"

# Leave blank until real details are supplied.
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_ADDRESS=

# Injected only when an ID is present AND APP_ENV=production.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

ADMIN_PASSWORD=

# CI-only header for synthetic smoke leads. Never expose to the public site.
CI_LEAD_MARKER=
