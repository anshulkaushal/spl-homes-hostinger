{
  "name": "spl-homes-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:hostinger": "prisma generate && npm run migrate:deploy && next build",
    "start": "next start",
    "migrate:deploy": "node scripts/migrate-remote.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 src/lib/*.test.ts src/app/*.test.ts",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "hostinger:deploy": "node scripts/hostinger-deploy.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "@playwright/test": "^1.55.0",
    "tsx": "^4.20.5",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
